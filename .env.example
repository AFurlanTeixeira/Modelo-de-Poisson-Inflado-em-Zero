# =============================================================================
# Variáveis de ambiente — copie este arquivo para .env e ajuste os valores.
# O arquivo .env está no .gitignore.
# Nenhuma delas é obrigatória: R/config.R tem defaults sensatos; o .env serve
# só para quem preferir fixar esses valores sem passar flag toda vez.
# =============================================================================

# -----------------------------------------------------------------------------
# Reprodutibilidade
# -----------------------------------------------------------------------------
# Semente do gerador de números aleatórios (Gibbs e checagem de Monte Carlo).
RANDOM_SEED=524

# -----------------------------------------------------------------------------
# Gibbs Sampler (Parte 3)
# -----------------------------------------------------------------------------
# Iterações por cadeia (o enunciado pede pelo menos 10.000).
N_ITER_GIBBS=20000
# Iterações iniciais descartadas de cada cadeia (o enunciado pede 2.000).
BURN_IN=2000

# -----------------------------------------------------------------------------
# Caminhos
# -----------------------------------------------------------------------------
DATA_PATH=data/raw/visitas_medicas.csv
DIR_PROCESSED=data/processed
DIR_FIGURAS=docs/figuras
